SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=lifepilot
POSTGRES_USER=lifepilot
POSTGRES_PASSWORD=replace-with-a-long-random-password
LIFE_PILOT_BOOTSTRAP_USERNAME=admin
LIFE_PILOT_BOOTSTRAP_PASSWORD=change-this-password
API_PORT=8000
MCP_PORT=8002
REDIS_PORT=16379
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Comma-separated browser origins; include each local or reverse-proxy URL used to open LifePilot.
WEB_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
PORTAINER_WEBHOOK_URL=
PORTAINER_API_URL=
PORTAINER_API_KEY=
PORTAINER_ENDPOINT_ID=0
PORTAINER_STACK_NAME=lifepilot
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=15
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=15
# Optional OpenAI-compatible Whisper service, e.g. http://whisper:8000/v1
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_TIMEOUT_SECONDS=90
# Optional Web Push; generate once with python -m lifepilot.push_keys
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=
# Optional trusted IMAPS host for manual message import
IMAP_HOST=
IMAP_PORT=993
